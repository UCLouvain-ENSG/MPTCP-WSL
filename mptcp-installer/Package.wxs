<?xml version="1.0" encoding="UTF-8"?>

<!-- Define the variables in "$(var.*) expressions" -->
<?define Name = "MPTCP Enabler" ?>
<?define Manufacturer = "MPTCP" ?>
<?define Version = "1.3.2.0" ?>
<?define UpgradeCode = "9ED3FF33-8718-444E-B44B-69A2344B7E98" ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Package Name="$(Name)"
			 Manufacturer="$(Manufacturer)"
			 Version="$(Version)"
			 UpgradeCode="$(var.UpgradeCode)"
			 Compressed="true">

		<!-- Allow upgrades and prevent downgrades -->
		<MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit." />

		<!-- A single self-contained .msi, no side-by-side .cab -->
		<MediaTemplate EmbedCab="yes" />

		<!-- Define the directory structure -->
		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFilesFolder">

				<!-- Create a folder inside program files -->
				<Directory Id="ROOTDIRECTORY" Name="$(var.Manufacturer)">

					<!-- Create a folder within the parent folder given the name -->
					<Directory Id="INSTALLFOLDER" Name="$(Name)"/>

				</Directory>
			</Directory>
		</Directory>

		<!-- The files inside this DirectoryRef are linked to
             the App.WindowsService directory via INSTALLFOLDER -->
		<DirectoryRef Id="INSTALLFOLDER">
			<!-- Create a single component which is the App.WindowsService.exe file -->
			<Component Id="ServiceExecutable" Bitness="always64">

				<!-- Copies the App.WindowsService.exe file using the
                     project reference preprocessor variables -->
				<File Id="mptcp_enabler.exe"
					  Source="$(var.EnablerPublishDir)\mptcp_enabler.exe"
					  KeyPath="true" />

				<!-- Include the bzImage file in the installation -->
				<File Id="bzImageFile"
					  Source="..\mptcp-kernel\bzImage"
					  KeyPath="no" />

				<!-- Remove all files from the INSTALLFOLDER on uninstall -->
				<RemoveFile Id="ALLFILES" Name="*.*" On="both" />

				<!-- Tell WiX to install the Service -->
				<ServiceInstall Id="ServiceInstaller"
								Type="ownProcess"
								Name="MPTCPEnabler"
								DisplayName="$(Name)"
								Description="Enable MPTCP Inside WSL2"
								Start="auto"
								ErrorControl="normal" />

				<!-- Tell WiX to start the Service -->
				<ServiceControl Id="StartService"
								Start="install"
								Stop="both"
								Remove="uninstall"
								Name="MPTCPEnabler"
								Wait="true" />
			</Component>
		</DirectoryRef>

		<!-- The tray icon, started at every logon of every user. -->
		<DirectoryRef Id="INSTALLFOLDER">
			<Component Id="TrayExecutable" Bitness="always64">
				<File Id="mptcp_tray.exe" Source="$(var.TrayPublishDir)\mptcp_tray.exe" KeyPath="true">
					<!-- Start menu entry; a second launch just finds the tray already running. -->
					<Shortcut Id="TrayStartMenuShortcut" Name="MPTCP Enabler" Description="MPTCP Enabler tray icon" Directory="ProgramMenuFolder" Advertise="yes" WorkingDirectory="INSTALLFOLDER" />
				</File>
				<RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="MPTCPTray" Type="string" Value="&quot;[INSTALLFOLDER]mptcp_tray.exe&quot;" />
			</Component>
		</DirectoryRef>

		<!-- The Linux side (systemd units, NetworkManager hook, proxy scripts), installed in the WSL distribution by the tray icon. -->
		<DirectoryRef Id="INSTALLFOLDER">
			<Directory Id="LINUXFOLDER" Name="linux" />
		</DirectoryRef>
		<DirectoryRef Id="LINUXFOLDER">
			<Component Id="LinuxFiles" Guid="6B1F2C3A-4D5E-4F60-8A7B-9C0D1E2F3A4B" Bitness="always64">
				<File Id="linux_install.sh" Source="..\mptcp-linux-service\install.sh" KeyPath="true" />
				<File Id="linux_mptcp_wsl.sh" Source="..\mptcp-linux-service\mptcp-wsl.sh" />
				<File Id="linux_mptcp_wsl.service" Source="..\mptcp-linux-service\mptcp-wsl.service" />
				<File Id="linux_mptcp_apply_endpoints" Source="..\mptcp-linux-service\mptcp-apply-endpoints" />
				<File Id="linux_mptcp_redsocks.conf" Source="..\mptcp-linux-service\mptcp-redsocks.conf" />
				<File Id="linux_iface_setup" Source="..\mptcp-linux-service\iface_setup" />
				<File Id="linux_mptcp_NetworkManager.conf" Source="..\mptcp-linux-service\mptcp-NetworkManager.conf" />
				<RemoveFile Id="ALLLINUXFILES" Name="*.*" On="both" />
				<RemoveFolder Id="RemoveLinuxFolder" On="uninstall" />
			</Component>
		</DirectoryRef>

		<!-- Windows turns the Wi-Fi off when an Ethernet cable is plugged in, which prevents using both together. -->
		<DirectoryRef Id="INSTALLFOLDER">
			<Component Id="KeepAllConnections" Bitness="always64">
				<RegistryValue Root="HKLM" Key="Software\Policies\Microsoft\Windows\WcmSvc\Local" Name="fMinimizeConnections" Type="integer" Value="0" KeyPath="yes" />
			</Component>
		</DirectoryRef>

		<!-- Tell WiX to install the files -->
		<Feature Id="Service" Title="MPTCP Enabler Setup" Level="1">
			<ComponentRef Id="ServiceExecutable" />
			<ComponentRef Id="TrayExecutable" />
			<ComponentRef Id="LinuxFiles" />
			<ComponentRef Id="KeepAllConnections" />
		</Feature>

	</Package>
</Wix>
