#!/bin/sh

# Print the path of config.json of the Windows user, as seen from WSL.
get_config_path() {
    cmd_exe=""
    cmd_drive=""
    for drive in /mnt/*; do
        if [ -x "$drive/Windows/System32/cmd.exe" ]; then
            cmd_exe="$drive/Windows/System32/cmd.exe"
            cmd_drive="$drive"
            break
        fi
    done
    [ -n "$cmd_exe" ] || return 1
    # cd to a Windows drive so that cmd.exe does not complain about a Linux working directory.
    win_profile=$(cd "$cmd_drive" && "$cmd_exe" /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')
    [ -n "$win_profile" ] || return 1
    unix_profile=$(wslpath -u "$win_profile") || return 1
    echo "$unix_profile/AppData/Local/MPTCP/config.json"
}

config_flag() {
    local input_mac="$1"
    local config_path
    config_path=$(get_config_path)
    if [ -z "$config_path" ] || [ ! -f "$config_path" ]; then
        return
    fi
    types=$(jq -r --arg input_mac "$input_mac" '.Config[] | select(.LinuxMacAddress == $input_mac) | .Types | join(" ")' "$config_path")
    flag="$(echo "$types" | tr -cd '[:alnum:] [:space:]')"
    command="ip mptcp endpoint add $DHCP4_IP_ADDRESS dev $DEVICE_IFACE $flag"
    cleaned_command=$(echo "$command" | tr -cd '[:alnum:][:space:].')
    $cleaned_command
}

# Remove every rule (there may be duplicates) and all routes of the table.
clear_table() {
    while ip rule del table "$table_id" 2>/dev/null; do :; done
    ip route flush table "$table_id"
}

table_id=$(( ${DEVICE_IFACE##*[!0-9]} + 1 ))
if [ "$NM_DISPATCHER_ACTION" = "down" ]; then
    clear_table
elif [ -n "$DHCP4_IP_ADDRESS" ]; then
        clear_table
        ip_route=$(echo "$IP4_ROUTE_0" | cut -d' ' -f1)
        ip route add "$ip_route" dev "$DEVICE_IFACE" scope link table "$table_id"
        ip route add default via "$IP4_GATEWAY" dev "$DEVICE_IFACE" table "$table_id"
        ip rule add from "$DHCP4_IP_ADDRESS" table "$table_id"
        mac_address=$(ip link show "$DEVICE_IFACE" | awk '/link\/ether/ {print $2}' | tr '[:lower:]' '[:upper:]' | sed 's/:/-/g')
       	existing_endpoints=$(ip mptcp endpoint show | grep "dev $DEVICE_IFACE" | awk '{print $3}')
        if [ -n "$existing_endpoints" ]; then
            for endpoint in $existing_endpoints; do
                ip mptcp endpoint delete id "$endpoint"
            done
        fi
	config_flag "$mac_address"
elif [ "$DEVICE_IFACE" = "eth0" ]; then
    ip route del default dev "$DEVICE_IFACE"
fi
