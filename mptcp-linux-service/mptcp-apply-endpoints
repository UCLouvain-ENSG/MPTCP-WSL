#!/bin/sh
# Apply the MPTCP mode now: re-create the MPTCP endpoint of every interface with the flags listed in its "Types"
# in config.json, and make the non-backup interfaces the preferred ones for the first subflow.
#
# The NetworkManager hook (iface_setup) only does this when an interface obtains an address, so the tray icon
# runs this script after it changes the mode:
#   aggregation: every interface has "subflow", all of them carry traffic;
#   fallback:    the primary interface has "subflow", the others "subflow backup" and only carry traffic
#                when the primary one fails.
# Run as root.

[ "$(id -u)" -eq 0 ] || { echo "must be run as root" >&2; exit 1; }

# Print the path of config.json of the Windows user, as seen from WSL (same lookup as iface_setup).
get_config_path() {
    cmd_exe=""
    cmd_drive=""
    for drive in /mnt/*; do
        if [ -x "$drive/Windows/System32/cmd.exe" ]; then
            cmd_exe="$drive/Windows/System32/cmd.exe"
            cmd_drive="$drive"
            break
        fi
    done
    [ -n "$cmd_exe" ] || return 1
    win_profile=$(cd "$cmd_drive" && "$cmd_exe" /c "echo %USERPROFILE%" 2>/dev/null </dev/null | tr -d '\r')
    [ -n "$win_profile" ] || return 1
    unix_profile=$(wslpath -u "$win_profile") || return 1
    echo "$unix_profile/AppData/Local/MPTCP/config.json"
}

cfg=$(get_config_path)
if [ -z "$cfg" ] || [ ! -f "$cfg" ] || ! jq -e . "$cfg" >/dev/null 2>&1; then
    echo "config.json not found or unreadable" >&2
    exit 1
fi

# Flags of an interface, from the "Types" of the config entry with the same MAC address.
flags_of() {
    mac=$(ip link show "$1" | awk '/link\/ether/ {print $2}' | tr 'a-f' 'A-F' | sed 's/:/-/g')
    out=""
    for t in $(jq -r --arg mac "$mac" '[.Config[] | select(.LinuxMacAddress == $mac) | .Types[]?] | join(" ")' "$cfg"); do
        # Only the flags the kernel knows; anything else in the file is ignored.
        case "$t" in
            subflow|signal|backup|fullmesh) out="$out $t" ;;
        esac
    done
    echo "$out"
}

devs=""
for dev in $(ls /sys/class/net | grep -E '^eth[1-9][0-9]*$' | sort -V); do
    [ -n "$(ip -4 -o addr show dev "$dev" scope global)" ] && devs="$devs $dev"
done
[ -n "$devs" ] || { echo "no attached interface has an address yet" >&2; exit 1; }

# 1. Route metrics. Every interface has a route to the LAN and a default route, and the first subflow leaves
#    through the best of them, so the non-backup interfaces get the lowest metric. The metric is set on the
#    NetworkManager connection, which applies it to all the routes of the interface (and keeps it across lease
#    renewals); routes added by hand would be re-created by NetworkManager next to the new ones.
n=0
for dev in $devs; do
    n=$((n + 1))
    case " $(flags_of "$dev") " in
        *" backup "*) metric=$((200 + n)) ;;
        *) metric=$((100 + n)) ;;
    esac
    con=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null)
    if [ -n "$con" ] && [ "$con" != "--" ]; then
        nmcli connection modify "$con" ipv4.route-metric "$metric" && nmcli device reapply "$dev" >/dev/null 2>&1
    else
        echo "$dev is not managed by NetworkManager: route metrics left as they are" >&2
    fi
    # Default routes added by hand (by an older version of this script, or mpup.sh) would shadow the new metrics.
    ip route show default dev "$dev" | grep -v 'proto dhcp' | while read -r route; do
        # shellcheck disable=SC2086
        ip route del $route 2>/dev/null
    done
done
# reapply makes NetworkManager run its dispatcher hook, which also re-creates the endpoints.
sleep 2

# 2. Endpoints.
n=0
for dev in $devs; do
    n=$((n + 1))
    addr=$(ip -4 -o addr show dev "$dev" scope global | awk '{print $4}' | cut -d/ -f1 | head -1)
    flags=$(flags_of "$dev")
    for id in $(ip mptcp endpoint show | awk -v d="$dev" '$0 ~ (" dev " d "( |$)") {print $3}'); do
        ip mptcp endpoint delete id "$id"
    done
    # shellcheck disable=SC2086
    ip mptcp endpoint add "$addr" dev "$dev" $flags
    echo "$dev $addr:${flags:- (no flag)}"
done
gw=$(ip route show default | awk '/via/ {print $3; exit}')
[ -z "$gw" ] || echo "first subflow towards $gw leaves through: $(ip route get "$gw" 2>/dev/null | head -1)"
